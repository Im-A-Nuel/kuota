# Copy to .env. Everything here is public configuration; no private keys belong in this file.
PORT=8787
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://api.devnet.solana.com
# Kuota's wallet address (public key only). It becomes the DBC partner on every launch.
KUOTA_TREASURY=
# Leave empty to use an in-memory database (data is lost on restart).
DATABASE_URL=
CORS_ORIGIN=http://localhost:3000
